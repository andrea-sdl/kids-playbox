{
  "name": "kids-playbox",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first games and little tools for kids.",
  "type": "module",
  "scripts": {
    "start": "python3 scripts/serve.py 8080",
    "test": "node --test \"tests/*.test.js\"",
    "offline": "node scripts/offline-manifest.mjs",
    "vendor": "esbuild scripts/three-entry.js --bundle --format=esm --minify --legal-comments=eof --outfile=vendor/three/three.min.js && cp node_modules/three/LICENSE vendor/three/LICENSE"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.186.1"
  }
}
